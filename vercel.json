{
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.7.1"
        }
    },
    "routes": [
        {
            "src": "/docs(/.*)?",
            "dest": "/docs/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
